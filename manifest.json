{
  "manifest_version": 3,
  "name": "FocusTube",
  "version": "1.0.0",
  "description": "Distraction-free YouTube study workspace.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["content/blocker.css","content/drawer.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}